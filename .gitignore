# ----------------------------------------
# Maven
# ----------------------------------------
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ----------------------------------------
# Java
# ----------------------------------------
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ----------------------------------------
# GraalVM Native Image
# ----------------------------------------
# compiled native binary (same name as artifactId)
*.dump
*.hprof

# ----------------------------------------
# macOS
# ----------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ----------------------------------------
# Logs & temp files
# ----------------------------------------
*.log
*.tmp
*.swp
*.swo

# ----------------------------------------
# Environment / secrets
# ----------------------------------------
.env
.env.*
*.pem
*.p12
*.jks
# Self-signed, non-secret SSL test fixtures are intentionally tracked.
!src/test/resources/ssl/*.pem
!src/test/resources/ssl/*.p12
!src/test/resources/ssl/*.jks

# ----------------------------------------
# IntelliJ IDEA
# ----------------------------------------
.idea/
*.iws
*.iml
*.ipr

# ----------------------------------------
# VS Code
# keep settings.json and extensions.json (project-shared config)
# ----------------------------------------
.vscode/*.code-workspace
.vscode/launch.json
.vscode/.ropeproject
.vscode/*.yml
.vscode/expected_objects_response.json
.vscode/expected_objects_schema.json
.vscode/new_item_post.json
 .vscode/test-suite-schema.json

# ----------------------------------------
# Claude Code
# ----------------------------------------
.claude/

# ----------------------------------------
# Spring Boot
# ----------------------------------------
spring-shell.log

# ----------------------------------------
# Python virtual environments
# ----------------------------------------
.venv/
venv/
env/
site/
