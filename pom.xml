<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
    <!-- lookup parent from repository -->
  </parent>
  <groupId>io.github.snytkine.cmdrest</groupId>
  <artifactId>cmd-rest</artifactId>
  <version>1.1.1-SNAPSHOT</version>
  <name>cmd-rest</name>
  <description>Spring Boot + Spring Shell CLI for running HTTP API test suites defined in YAML,
    with Thymeleaf expression support and GraalVM native-image compatibility.</description>
  <url>https://github.com/snytkine/cmd-rest</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Dmitri Snytkine</name>
      <email>d.snytkine@gmail.com</email>
      <url>https://github.com/snytkine</url>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/snytkine/cmd-rest.git</connection>
    <developerConnection>scm:git:https://github.com/snytkine/cmd-rest.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/snytkine/cmd-rest</url>
  </scm>
  <properties>
    <dependency-check-maven.version>12.1.3</dependency-check-maven.version>
    <dotenv-java.version>3.2.0</dotenv-java.version>
    <!-- Jackson 2.x BOM. Overrides spring-boot-dependencies 4.0.7 (2.21.4) to pick up
         the fix for CVE-2026-54515 / SNYK-JAVA-COMFASTERXMLJACKSONCORE-17972608
         (per-property @JsonIgnoreProperties exclusions leaking into the response).
         Reached transitively via jackson-dataformat-yaml. Drop this override once a
         Spring Boot release manages 2.21.5 or later. -->
    <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
    <!-- Jackson 3.x BOM. Overrides spring-boot-dependencies 4.0.7 (3.1.4) for
         SNYK-JAVA-TOOLSJACKSONCORE-17972609. Reached transitively via
         spring-boot-starter-jackson. Drop once Spring Boot manages 3.1.5 or later. -->
    <jackson-bom.version>3.1.5</jackson-bom.version>
    <!-- Overridden to true by the jacoco-check-skip-windows profile; see that profile
         and the jacoco-check execution for why the gate is not enforced on Windows. -->
    <jacoco.check.skip>false</jacoco.check.skip>
    <jacoco.version>0.8.15</jacoco.version>
    <java.version>25</java.version>
    <java.target.version>21</java.target.version>
    <json-schema-validator.version>1.5.4</json-schema-validator.version>
    <!-- Overrides spring-boot-dependencies 4.0.7 (1.5.34) for the expression-injection
         issue SNYK-JAVA-CHQOSLOGBACK-17675439 in logback-core, fixed in 1.5.36. Pinned
         to the latest 1.5.x patch rather than 1.6.x to stay on the line Spring Boot
         tests against. Drop once Spring Boot manages 1.5.36 or later. -->
    <logback.version>1.5.38</logback.version>
    <!-- NVD API key for the dependency-check profile. Deliberately empty here: the
         real key is a secret and must never be committed. Override it per-machine in
         ~/.m2/settings.xml (see the dependency-check profile below). Without a key
         the NVD feed is heavily rate-limited and an update takes ~10+ minutes. -->
    <nvd.api.key/>
    <opentest4j.version>1.3.0</opentest4j.version>
    <palantir-java-format.version>2.74.0</palantir-java-format.version>
    <spring-shell.version>4.0.2</spring-shell.version>
    <spotless.version>2.43.0</spotless.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.shell</groupId>
        <artifactId>spring-shell-dependencies</artifactId>
        <version>${spring-shell.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>${dotenv-java.version}</version>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.opentest4j</groupId>
      <artifactId>opentest4j</artifactId>
      <version>${opentest4j.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-jline</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <licenseHeader>
              <file>${project.basedir}/src/main/resources/license-header.txt</file>
            </licenseHeader>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
              <!-- Fixes the internal javac error -->
            </palantirJavaFormat>
            <importOrder/>
            <removeUnusedImports/>
            <formatAnnotations/>
          </java>
          <pom>
            <sortPom>
              <encoding>UTF-8</encoding>
              <expandEmptyElements>false</expandEmptyElements>
              <sortDependencies>scope,groupId,artifactId</sortDependencies>
              <sortPlugins>groupId,artifactId</sortPlugins>
            </sortPom>
          </pom>
          <yaml>
            <includes>
              <include>src/**/*.yml</include>
              <include>src/**/*.yaml</include>
            </includes>
            <jackson/>
          </yaml>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>21</source>
          <target>21</target>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Enables Basic proxy authentication over CONNECT tunnels for the test JVM.
                 The JDK disables Basic for tunneling by default, which would make every
                 proxy-authentication test against an https target fail silently. The
                 application does the same for itself in main(); tests never call main(),
                 and the property has to be set before any JDK HTTP class initializes, so
                 it must be set here rather than in a @BeforeAll. See ProxyTunnelingSupport. -->
            <jdk.http.auth.tunneling.disabledSchemes/>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <includes>
                <include>io/github/snytkine/cmdrest/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>test</phase>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <!-- Skipped on Windows only. A large set of tests is annotated
                   @DisabledOnOs(OS.WINDOWS) because their fixtures are POSIX shell
                   scripts with shebang lines that Windows cannot execute (script
                   lifecycle hooks). Those tests still run on Linux and macOS, where
                   this gate is enforced on every commit, so the coverage ratios it
                   measures are a property of the code rather than of the build
                   platform. Enforcing it on Windows only re-reports the 45
                   deliberately skipped tests as a coverage failure. Tests themselves
                   still run on Windows — only this check is skipped. -->
              <skip>${jacoco.check.skip}</skip>
              <!-- Coverage is enforced everywhere except code that cannot be
                   meaningfully unit tested:
                   - commands/TuiSmokeCommand drives the interactive TUI and needs a
                     real terminal; it is the only command excluded. The rest of the
                     commands package is enforced.
                   - org/springframework/shell/core/autoconfigure/* is not project
                     code: Spring Boot AOT emits __BeanDefinitions classes into
                     target/classes under this Spring Shell package name. -->
              <excludes>
                <exclude>io/github/snytkine/cmdrest/commands/TuiSmokeCommand*</exclude>
                <exclude>org/springframework/shell/core/autoconfigure/*</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>COMPLEXITY</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Disables the JaCoCo coverage gate on Windows. Script-hook tests use POSIX
         shell fixtures and are @DisabledOnOs(OS.WINDOWS), so ~45 tests are skipped
         there by design and the resulting ratios are not comparable to Linux/macOS.
         The gate still runs on every commit on the other two platforms. Activates
         automatically; no CI flag required. -->
    <profile>
      <id>jacoco-check-skip-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jacoco.check.skip>true</jacoco.check.skip>
      </properties>
    </profile>
    <!-- OWASP dependency-check: scans the resolved dependency tree against the NVD
         and fails the build on a CVE at or above failBuildOnCVSS. Local-only by
         design: the activation below keys off the absence of the CI environment
         variable, which GitHub Actions always sets to "true", so the profile can
         never activate there (Snyk covers CI — see .github/workflows/snyk.yml).
         Skip it for a single build with -Ddependency-check.skip=true. -->
    <profile>
      <id>dependency-check</id>
      <activation>
        <property>
          <name>!env.CI</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <!-- Supplied per-machine from ~/.m2/settings.xml; empty by default. -->
              <nvdApiKey>${nvd.api.key}</nvdApiKey>
              <!-- 7.0 = "high". Lower to 4.0 to also fail on medium findings. -->
              <failBuildOnCVSS>7.0</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
              <!-- Test-only and provided dependencies do not ship in the artifact. -->
              <skipTestScope>true</skipTestScope>
              <skipProvidedScope>true</skipProvidedScope>
              <!-- The Sonatype OSS Index analyzer is a live lookup against
                   ossindex.sonatype.org, separate from the NVD feed that nvdApiKey
                   above authenticates. Sonatype dropped anonymous access, so every
                   unauthenticated run now returns HTTP 401 and fails the goal. We
                   rely on the NVD (plus Snyk in CI) and do not want the dependency
                   list POSTed to a third party, so it is off. To re-enable, register
                   a free OSS Index account and add an <ossIndexServerId> pointing at
                   a server entry in ~/.m2/settings.xml. -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <id>dependency-check</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs>
                <arg>-Os</arg>
                <arg>-J-Dslf4j.internal.verbosity=ERROR</arg>
                <arg>--enable-native-access=ALL-UNNAMED</arg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <profiles>
                <profile>native</profile>
              </profiles>
            </configuration>
            <executions>
              <execution>
                <id>process-aot</id>
                <goals>
                  <goal>process-aot</goal>
                </goals>
                <phase>prepare-package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
